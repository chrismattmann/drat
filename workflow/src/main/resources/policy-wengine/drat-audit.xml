<!--
  DRAT's audit pipeline expressed as one workflow, for the wengine / W2 engine.

  Today DRAT does not use the engine to orchestrate this at all: ProcessDratWrapper
  fires three separate single-task dynamic workflows and sequences them in Java by
  polling, with

      while (stillRunning(PARTITION_AND_MAP_TASK_ID) || stillRunning(MAPPER_TASK_ID))

  standing in for a dependency. conditions.xml already carries the condition that
  loop replaces, CheckForPrerequisiteJob, but it is commented out, while
  tasks.xml still references it, so the reference dangles.

  Written in the generic workflow-with-execution-attribute spelling rather than
  the sequential tag, so the phases are named containers whose strategy is
  declared rather than encoded in the tag. Both spellings mean the same thing
  to the engine.
-->
<cas:workflows xmlns="http://oodt.jpl.nasa.gov/2.0/cas"
  xmlns:cas="http://oodt.jpl.nasa.gov/2.0/cas">

  <workflow id="urn:drat:AuditPipeline" name="DRAT Audit Pipeline"
            execution="sequential">

    <!-- Partition the crawled corpus by mime type and fan out RatCodeAudit jobs. -->
    <workflow id="urn:drat:PartitionPhase" name="Partition Phase"
              execution="sequential">
      <task id-ref="urn:drat:MimePartitioner"/>
    </workflow>

    <!--
      The aggregate phase waits on its conditions rather than on a sleep loop.
      The block is declared sequential, which means each condition is evaluated
      only after the one before it has passed. That is deliberate: conditions
      have always been evaluated all at once regardless of what the block said,
      so sequential is the declaration that actually changes behaviour here.
    -->
    <workflow id="urn:drat:AggregatePhase" name="Aggregate Phase"
              execution="sequential">
      <conditions execution="sequential" type="pre">
        <condition id-ref="urn:drat:MapsSettling"/>
        <condition id-ref="urn:drat:MapsDone"/>
      </conditions>
      <task id-ref="urn:drat:RatAggregator"/>
    </workflow>

  </workflow>

  <task id="urn:drat:MimePartitioner" name="MimePartitioner"
        class="org.apache.oodt.cas.pge.StdPGETaskInstance">
    <conditions/>
    <configuration>
      <property name="PGETask_Name" value="MimePartitioner"/>
      <property name="PGETask_ConfigFilePath" value="[DRAT_HOME]/pge/policy/PgeConfig_MimePartitioner.xml" envReplace="true"/>
      <property name="PGETask_DumpMetadata" value="true"/>
      <property name="PCS_WorkflowManagerUrl" value="[WORKFLOW_URL]" envReplace="true"/>
      <property name="PCS_FileManagerUrl" value="[FILEMGR_URL]" envReplace="true"/>
      <property name="PCS_MetFileExtension" value="met"/>
      <property name="PCS_ClientTransferServiceFactory" value="org.apache.oodt.cas.filemgr.datatransfer.LocalDataTransferFactory"/>
      <property name="SolrUrl" value="[SOLR_URL]/drat" envReplace="true"/>
      <property name="RatTaskId" value="urn:drat:RatCodeAudit"/>
      <property name="NumFilesPerJob" value="100"/>
      <property name="PythonExecutable" value="python3"/>
      <property name="MimePartitionerPyScript" value="[DRAT_HOME]/pge/bin/mime_partitioner/mime_rat_partitioner.py" envReplace="true"/>
    </configuration>
  </task>

  <!--
    Not placed in the pipeline above: MimePartitioner fires one of these per
    batch of NumFilesPerJob files, through RatTaskId. It is defined here so the
    dynamic workflows it starts resolve against this repository.
  -->
  <task id="urn:drat:RatCodeAudit" name="RatCodeAudit"
        class="org.apache.oodt.cas.pge.StdPGETaskInstance">
    <conditions/>
    <configuration>
      <property name="PGETask_Name" value="RatCodeAudit"/>
      <property name="PGETask_ConfigFilePath" value="[DRAT_HOME]/pge/policy/PgeConfig_Rat.xml" envReplace="true"/>
      <property name="PGETask_DumpMetadata" value="true"/>
      <property name="PCS_WorkflowManagerUrl" value="[WORKFLOW_URL]" envReplace="true"/>
      <property name="PCS_FileManagerUrl" value="[FILEMGR_URL]" envReplace="true"/>
      <property name="PCS_MetFileExtension" value="met"/>
      <property name="PCS_ClientTransferServiceFactory" value="org.apache.oodt.cas.filemgr.datatransfer.LocalDataTransferFactory"/>
    </configuration>
    <requiredMetFields>
      <metfield name="InputFiles"/>
      <metfield name="MimeType"/>
    </requiredMetFields>
  </task>

  <task id="urn:drat:RatAggregator" name="RatAggregator"
        class="org.apache.oodt.cas.pge.StdPGETaskInstance">
    <conditions/>
    <configuration>
      <property name="PGETask_Name" value="RatAggregator"/>
      <property name="PGETask_ConfigFilePath" value="[DRAT_HOME]/pge/policy/PgeConfig_RatAggregator.xml" envReplace="true"/>
      <property name="PGETask_DumpMetadata" value="true"/>
      <property name="PCS_WorkflowManagerUrl" value="[WORKFLOW_URL]" envReplace="true"/>
      <property name="PCS_FileManagerUrl" value="[FILEMGR_URL]" envReplace="true"/>
      <property name="PCS_MetFileExtension" value="met"/>
      <property name="PCS_ClientTransferServiceFactory" value="org.apache.oodt.cas.filemgr.datatransfer.LocalDataTransferFactory"/>
      <property name="PythonExecutable" value="python3"/>
      <property name="RatAggregatorScript" value="[DRAT_HOME]/pge/bin/rat_aggregator/rat_aggregator.py" envReplace="true"/>
    </configuration>
  </task>

  <!--
    Two conditions that take a while on purpose. LongCondition returns false a
    number of times before it passes, so the pair makes the ordering visible:
    under a sequential block the second must not begin until the first has
    passed, where previously both began at once.
  -->
  <condition id="urn:drat:MapsSettling" name="Maps Settling"
             class="org.apache.oodt.cas.workflow.examples.LongCondition"/>
  <condition id="urn:drat:MapsDone" name="Maps Done"
             class="org.apache.oodt.cas.workflow.examples.LongCondition"/>

</cas:workflows>
