<cas:conditions xmlns:cas="http://oodt.jpl.nasa.gov/1.0/cas">

  <!--
    The gate on the aggregate, the same pair policy-wengine/drat-audit.xml
    declares for W2: same class, same properties, same ids.

    Both watch how many RatLog products the catalog holds. An audit ingests
    one when it finishes, so the count climbing means audits are still
    landing and the count holding still means they have stopped. MapsSettling
    asks only that audits have started producing and paused briefly, so the
    aggregate cannot run against an empty catalog; MapsDone then waits for a
    full minute of quiet.

    They ask the file manager rather than the workflow engine, which is why
    the same declaration works on either. The condition this replaces asked
    the resource manager about its jobs, which is true of one engine's scheduling
    and meaningless under the other, which is why it sat commented out.
  -->
  <condition id="urn:drat:MapsSettling" name="Maps Settling"
             class="org.apache.oodt.cas.pge.condition.ProductCountSettledCondition">
    <configuration>
      <property name="FileManagerUrl" value="[FILEMGR_URL]" envReplace="true"/>
      <property name="ProductTypeName" value="RatLog"/>
      <property name="MinCount" value="1"/>
      <property name="QuietSeconds" value="20"/>
    </configuration>
  </condition>

  <condition id="urn:drat:MapsDone" name="Maps Done"
             class="org.apache.oodt.cas.pge.condition.ProductCountSettledCondition">
    <configuration>
      <property name="FileManagerUrl" value="[FILEMGR_URL]" envReplace="true"/>
      <property name="ProductTypeName" value="RatLog"/>
      <property name="MinCount" value="1"/>
      <property name="QuietSeconds" value="60"/>
    </configuration>
  </condition>

