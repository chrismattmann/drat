<cas:tasks xmlns:cas="http://oodt.jpl.nasa.gov/1.0/cas">

  <task id="urn:drat:RatCodeAudit" name="RadCodeAudit" 
    class="org.apache.oodt.cas.pge.StdPGETaskInstance">
        <conditions/>
        <configuration>
          <property name="PGETask_Name" value="RatCodeAudit"/>
          <property name="PGETask_ConfigFilePath" value="[DRAT_HOME]/pge/policy/PgeConfig_Rat.xml" envReplace="true"/>
          <property name="PGETask_DumpMetadata" value="true"/>
          <property name="PCS_WorkflowManagerUrl" value="[WORKFLOW_URL]" envReplace="true" />
          <property name="PCS_FileManagerUrl"     value="[FILEMGR_URL]" envReplace="true"/>
          <property name="PCS_MetFileExtension" value="met"/>
          <property name="PCS_ClientTransferServiceFactory" value="org.apache.oodt.cas.filemgr.datatransfer.LocalDataTransferFactory"/>
          <requiredMetFields>
            <metfield name="InputFiles"/>
	        <metfield name="MimeType"/>
          </requiredMetFields>        
    </configuration>
  </task>

  <!--
    The crawl and the index, as tasks. Same classes and the same
    configuration as policy-wengine/drat-audit.xml declares for W2: what to
    crawl arrives with the run under ProductPath, and the exclusion regex as
    SysProp.DRAT_EXCLUDE, so one definition serves whichever repository is
    being audited.
  -->
  <task id="urn:drat:RepoCrawler" name="RepoCrawler"
    class="org.apache.oodt.cas.crawl.workflow.CrawlerTaskInstance">
        <conditions/>
        <configuration>
          <property name="CrawlerBeanRepo" value="[DRAT_HOME]/crawler/policy/crawler-config.xml" envReplace="true"/>
          <property name="CrawlerId" value="MetExtractorProductCrawler"/>
          <property name="MetExtractor" value="org.apache.oodt.cas.metadata.extractors.CopyAndRewriteExtractor"/>
          <property name="MetExtractorConfig" value="[DRAT_HOME]/extractors/code/default.cpr.conf" envReplace="true"/>
          <property name="FileManagerUrl" value="[FILEMGR_URL]" envReplace="true"/>
          <property name="ClientTransferer" value="org.apache.oodt.cas.filemgr.datatransfer.InPlaceDataTransferFactory"/>
          <property name="PreCondIds" value="RegExExcludeComparator"/>
        </configuration>
  </task>

  <task id="urn:drat:SolrIndexer" name="SolrIndexer"
    class="org.apache.oodt.cas.crawl.workflow.SolrIndexerTaskInstance">
        <conditions/>
        <configuration>
          <property name="SolrUrl" value="[SOLR_URL]/drat" envReplace="true"/>
          <property name="FileManagerUrl" value="[FILEMGR_URL]" envReplace="true"/>
          <property name="IndexerConfig" value="[DRAT_HOME]/filemgr/etc/indexer.properties" envReplace="true"/>
        </configuration>
  </task>

  <task id="urn:drat:MimePartitioner" name="MimePartitioner" 
    class="org.apache.oodt.cas.pge.StdPGETaskInstance">
        <conditions/>
        <configuration>
          <property name="PGETask_Name" value="MimePartitioner"/>
          <property name="PGETask_ConfigFilePath" value="[DRAT_HOME]/pge/policy/PgeConfig_MimePartitioner.xml" envReplace="true"/>
          <property name="PGETask_DumpMetadata" value="true"/>
          <property name="PCS_WorkflowManagerUrl" value="[WORKFLOW_URL]" envReplace="true" />
          <property name="PCS_FileManagerUrl"     value="[FILEMGR_URL]" envReplace="true"/>
          <property name="PCS_MetFileExtension" value="met"/>
          <property name="PCS_ClientTransferServiceFactory" value="org.apache.oodt.cas.filemgr.datatransfer.LocalDataTransferFactory"/>
	      <property name="SolrUrl" value="http://localhost:8983/solr/drat"/>
          <property name="RatTaskId" value="urn:drat:RatCodeAudit"/>
          <property name="NumFilesPerJob" value="100"/>
          <property name="PythonExecutable" value="python3"/>
          <property name="MimePartitionerPyScript" value="[DRAT_HOME]/pge/bin/mime_partitioner/mime_rat_partitioner.py"/>
          <requiredMetFields/>
    </configuration>
  </task>

  <task id="urn:drat:RatAggregator" name="RatAggregator" 
    class="org.apache.oodt.cas.pge.StdPGETaskInstance">
    <!--
      The gate: the aggregate does not start until the audits have stopped
      landing. Declared here rather than on the workflow, so it travels with
      the task and every path that runs the aggregator is gated, including
      the single-task dynamic workflow that "drat reduce" submits.

      This replaces a stub that asked the resource manager whether particular
      jobs were still queued. That would have been a fact about how one
      engine schedules; these ask the file manager what it holds, which is
      the same question on either engine. Defined in conditions.xml.
    -->
    <conditions>
      <condition id="urn:drat:MapsSettling"/>
      <condition id="urn:drat:MapsDone"/>
    </conditions>

        <configuration>
          <property name="PGETask_Name" value="RatAggregator"/>
          <property name="PGETask_ConfigFilePath" value="[DRAT_HOME]/pge/policy/PgeConfig_RatAggregator.xml" envReplace="true"/>
          <property name="PGETask_DumpMetadata" value="true"/>
          <property name="PCS_WorkflowManagerUrl" value="[WORKFLOW_URL]" envReplace="true" />
          <property name="PCS_FileManagerUrl"     value="[FILEMGR_URL]" envReplace="true"/>
          <property name="PCS_MetFileExtension" value="met"/>
          <property name="PCS_ClientTransferServiceFactory" value="org.apache.oodt.cas.filemgr.datatransfer.LocalDataTransferFactory"/>
          <property name="PythonExecutable" value="python3"/>
          <property name="RatAggregatorScript" value="[DRAT_HOME]/pge/bin/rat_aggregator/rat_aggregator.py"/>
          <requiredMetFields/>
    </configuration>
  </task>

</cas:tasks>
