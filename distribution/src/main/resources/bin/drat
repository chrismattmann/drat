# Stop on first error.
set -e

# Where this deployment lives.
#
# Everything below is addressed relative to this, and unset it addressed
# nothing: paths came out as /workflow/etc, /data/archive and /logs, so
# reset reported it had no configuration to read and carried on. Taken from
# the script's own location so the deployment can be driven from where it is
# installed; an exported DRAT_HOME still wins.
DRAT_HOME=${DRAT_HOME:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}
export DRAT_HOME

# What this deployment says about itself.
#
# setenv.sh is where a deployment declares its host, its ports and the URLs
# derived from them, and every service control script reads it. This script
# used to carry its own copy of those defaults, so a deployment that moved
# off 8080 and 8983 in setenv.sh still got 8080 and 8983 here: "drat go"
# posted its reset to whatever owned 8080, curl returned a 404, and under
# set -e the run ended after one line of output. One place declares the
# deployment; this reads it and fills in only what it does not set.
if [ -r "$DRAT_HOME/bin/setenv.sh" ]; then
    . "$DRAT_HOME/bin/setenv.sh"
fi

# Hostname where OODT services are deployed
OODT_HOST=${OODT_HOST:-localhost}

# The ports DRAT's own Tomcat and Solr listen on.
#
# These were written into every URL below. That works only where DRAT owns
# 8080 and 8983; on a host running a second OODT deployment they belong to
# something else, and two of the calls here -- the reset POST and
# solr_delete_all -- are destructive. Overridable so a deployment can say
# where its own services are.
TOMCAT_PORT=${TOMCAT_PORT:-8080}
SOLR_PORT=${SOLR_PORT:-8983}

# Print out usage information for this script.
function print_help {
    echo "Usage: drat [crawl, index, map, reduce] in order to analyze a repository." 
    echo "       Alternatively, call 'drat go' to run all four automatically."
    echo "       drat"
    echo "            go [--full-wipe] [--exclude <name>[,<name>...]]... <path to repo>"
    echo "                                                                   | start OODT and analyze the repository"
    echo "            audit                                                      | run the whole audit as one workflow"
    echo "            crawl [--exclude <name>[,<name>...]]... <path to repo>	| crawl the repository files"
    echo "                                                                   | --exclude may be repeated, e.g."
    echo "                                                                   |   --exclude target --exclude .git"
    echo "            index <path to repo>  					| index the crawled files"
    echo "            map                   					| fire off the MapReduce mapper"
    echo "            reduce                					| fire off the MapReduce reducer"
    echo "            help                  					| print this message"
    echo "            reset                 					| clear runtime crawl state, preserving DRAT stats"
    echo "            delstats                                                    | clear collected DRAT stats index"
}

function print_ui_info {
    echo "Navigate to http://${OODT_HOST}:${TOMCAT_PORT}/opsui/ to view the OODT browser and http://${OODT_HOST}:${SOLR_PORT}/solr to view the Solr catalog."
}

FILEMGR_URL=http://${OODT_HOST}:9000
# The DRAT core, not the Solr server. setenv.sh calls the server SOLR_URL and
# the core SOLR_DRAT_URL; this file used SOLR_URL for the core, so the two
# disagreed about what the name meant. Use the deployment's name for it.
SOLR_DRAT_URL=${SOLR_DRAT_URL:-http://${OODT_HOST}:${SOLR_PORT}/solr/drat}

# Prefer the JDK DRAT is configured with over whatever happens to be on PATH.
if [ -n "$JAVA_HOME" ] && [ -x "$JAVA_HOME/bin/java" ]; then
    RUNJAVA="$JAVA_HOME/bin/java"
else
    RUNJAVA=java
fi
CLIENT_URL=http://${OODT_HOST}:9001
OPSUI_URL=http://${OODT_HOST}:${TOMCAT_PORT}/opsui

# Where this deployment's PCS services answer. The audit is followed through
# these rather than by matching status names: which names mean "finished"
# differs between the two engines, and the lifecycle that knows the answer is
# read there rather than restated here.
PCS_SERVICES_URL=${PCS_SERVICES_URL:-http://${OODT_HOST}:${TOMCAT_PORT}/pcs/services}

# The audit, as one workflow. Both engines answer to this id: W1 through the
# event of the same name in events.xml, W2 because it registers an event for
# every workflow id it parses.
AUDIT_WORKFLOW_ID=${AUDIT_WORKFLOW_ID:-urn:drat:AuditPipeline}

# Build a single exclusion regex from any number of file/directory names.
#
# One --exclude was never enough for a real repository: a source tree that
# needs "target" out of the audit almost always needs ".git" out too, and
# with a single pattern the second one silently stayed in. Auditing 8000
# compiled .class files under target/ for license headers tells you nothing.
#
# Every name is regex-escaped and the names are joined into one alternation,
# so the matching semantics are exactly what they were for one name:
# a whole path component, anywhere in the path.
function build_exclude_regex {
    local joined=
    local name
    for name in "$@"; do
        [[ -z "$name" ]] && continue
        name=$(printf '%s' "$name" | sed 's/[][\/.^$*+?(){}|]/\\&/g')
        if [[ -z "$joined" ]]; then
            joined="$name"
        else
            joined="$joined|$name"
        fi
    done
    [[ -z "$joined" ]] && return 0
    printf '%s' ".*(^|/)($joined)(/|\$).*"
}

# Crawl the given repository. Expects the file path of the repo to be crawled,
# optionally preceded by any number of --exclude <file/directory name> pairs.
# --exclude may also be given a comma-separated list.
function crawl {
    check_services_running
    local -a EXCLUDE_NAMES=()
    while [[ "${1:-}" == "--exclude" ]]; do
        if [[ $# -lt 2 ]]; then
            echo "Expected an exclude value after '--exclude'."
            print_help
            exit 1
        fi
        # A comma-separated value is split, so both spellings work.
        local IFS=,
        local part
        for part in $2; do
            EXCLUDE_NAMES+=("$part")
        done
        unset IFS
        shift 2
    done
    check_num_args "crawl" $# 1
    PRODUCT_PATH=$1
    if [[ ${#EXCLUDE_NAMES[@]} -gt 0 ]]; then
        export DRAT_EXCLUDE=$(build_exclude_regex "${EXCLUDE_NAMES[@]}")
        echo "Excluding path components: ${EXCLUDE_NAMES[*]}"
    else
        export DRAT_EXCLUDE=""
    fi
    pushd $DRAT_HOME/crawler/bin >> $DRAT_HOME/logs/drat.log 2>&1
   
    python dump_repo_details.py $PRODUCT_PATH


   JAVA_OPTS="${JAVA_OPTS:-} -DDRAT_EXCLUDE=${DRAT_EXCLUDE}" ./crawler_launcher --operation --metPC --metExtractorConfig \
   $DRAT_HOME/extractors/code/default.cpr.conf --metExtractor org.apache.oodt.cas.metadata.extractors.CopyAndRewriteExtractor \
   --filemgrUrl $FILEMGR_URL --clientTransferer org.apache.oodt.cas.filemgr.datatransfer.InPlaceDataTransferFactory \
   --preCondIds RegExExcludeComparator --productPath $PRODUCT_PATH

    popd >> $DRAT_HOME/logs/drat.log 2>&1
    export DRAT_EXCLUDE=""
}

# Index the crawled files of the given repo. Expects one argument -- the file path of the repo to be indexed.
function index {
    check_services_running
    check_num_args "index" $# 1
    pushd $DRAT_HOME/filemgr/bin >> $DRAT_HOME/logs/drat.log 2>&1
    # Bare "java" takes whatever is first on PATH, which is often an older
    # JDK than the one DRAT is configured for. SolrJ 10 is compiled for Java
    # 17, so this step failed with UnsupportedClassVersionError on a machine
    # whose default java was 11, while the services themselves ran fine on
    # JAVA_HOME.
    "$RUNJAVA" -DSOLR_INDEXER_CONFIG=../etc/indexer.properties -cp "../lib/*" \
    org.apache.oodt.cas.filemgr.tools.SolrIndexer --all --fmUrl $FILEMGR_URL --optimize --solrUrl $SOLR_DRAT_URL $1
    popd >> $DRAT_HOME/logs/drat.log 2>&1
}

# Fire off the MapReduce mapper. Expects no arguments.
function map {
    check_services_running
    check_num_args "map" $# 0
    pushd $DRAT_HOME/workflow/bin >> $DRAT_HOME/logs/drat.log 2>&1
    ./wmgr-client --url $CLIENT_URL --operation --dynWorkflow --taskIds urn:drat:MimePartitioner
    popd >> $DRAT_HOME/logs/drat.log 2>&1
    print_ui_info
}

# Get the current list of RatAuditTasks running.
function current_pges {
    pushd $DRAT_HOME/workflow/bin >> $DRAT_HOME/logs/drat.log 2>&1
    status=$(./wmgr-client --url $CLIENT_URL --operation --getFirstPage --status "PGE EXEC" 2>&1 || true)
    popd >> $DRAT_HOME/logs/drat.log 2>&1
    echo "$status" | grep "currentTask=urn:drat:RatCodeAudit" || true
}

# Fire off the MapReduce reducer. Expects no arguments.
# Start the audit: one workflow instance for partition, map and aggregate.
#
# The phases used to be submitted as three separate single-task dynamic
# workflows with the ordering between them kept in this script. The engine
# already knows the ordering, the gate on RatAggregator already knows when
# the map is finished, and one instance is something anyone can ask about
# afterwards. This submits it and says nothing else about sequencing.
function audit {
    check_services_running
    check_num_args "audit" $# 0
    pushd $DRAT_HOME/workflow/bin >> $DRAT_HOME/logs/drat.log 2>&1
    ./wmgr-client --url $CLIENT_URL --operation --sendEvent \
        --eventName "$AUDIT_WORKFLOW_ID"
    popd >> $DRAT_HOME/logs/drat.log 2>&1
}

# Every workflow instance this deployment currently holds, as
# "<id>\t<ended?>".
function all_instances {
    local body page=1 total=1
    while [[ $page -le $total ]]; do
        body=$(curl -sf "${PCS_SERVICES_URL}/workflow/instances?status=ALL&page=${page}" 2>/dev/null) || return 0
        printf '%s' "$body" | python3 -c '
import json, sys
try:
    page = json.load(sys.stdin)["page"]
except Exception:
    sys.exit(0)
sys.stderr.write(str(page.get("totalPages") or 1))
for inst in page.get("instances") or []:
    print("%s\t%s" % (inst.get("id") or "-",
                      (inst.get("endDateTime") or "").strip()))
' 2>"$DRAT_HOME/logs/.drat_pages"
        total=$(cat "$DRAT_HOME/logs/.drat_pages" 2>/dev/null || echo 1)
        page=$((page + 1))
    done
    rm -f "$DRAT_HOME/logs/.drat_pages"
}

# The ids of every instance that exists right now, space separated.
function instance_ids {
    all_instances | cut -f1 | tr '\n' ' '
}

# Wait until everything this run started has finished.
#
# Not "wait until the audit instance has an end date": under W2 the pipeline
# instance dispatches redirectors to its phases and finishes at once -- in a
# two minute run it ended after two seconds -- so its end date says the work
# was handed out, not that it is done. Under W1 the audit is a single flat
# instance and its end date is exactly the answer. Waiting for every instance
# this run brought into being to carry an end date is the same question on
# both engines, and it also covers the per mime type audits the partitioner
# submits, which belong to no workflow named here.
#
# Instances that existed beforehand are left out on purpose. Some of them may
# never finish -- an engine restart leaves instances no one is running, and
# waiting on those would wait for ever.
function wait_for_audit {
    local before=" $1 "
    local line id ended pending waited=0
    printf "Waiting for the audit to finish"
    while true; do
        pending=0
        while IFS=$'\t' read -r id ended; do
            [[ -z "$id" ]] && continue
            [[ "$before" == *" $id "* ]] && continue
            [[ -z "$ended" ]] && pending=$((pending + 1))
        done < <(all_instances)

        if [[ $pending == 0 ]] && [[ $waited -gt 0 ]]; then
            echo
            echo "The audit finished."
            return 0
        fi
        if [[ $((waited % 60)) == 0 ]] && [[ $waited -gt 0 ]]; then
            echo
            printf "  %s instances still running" "$pending"
        fi
        printf "."
        sleep 5
        waited=$((waited + 5))
    done
}

function reduce {
    check_services_running
    check_num_args "reduce" $# 0
    if [[ -n $(current_pges) ]]; then
        echo "There are still MapReduce mappers running! It is reccomended you wait for them to finish, "
        echo "then try to run '\$DRAT_HOME/bin/drat reduce' again later."
        read -p "Are you sure you wish to continue? [yN] " yn
            case $yn in
                [Yy]*)
                    echo "Continuing..."
                ;;
                *)
                    echo "Exiting..."
                    exit 0
                ;;
            esac
    fi
    pushd $DRAT_HOME/workflow/bin >> $DRAT_HOME/logs/drat.log 2>&1
    ./wmgr-client --url $CLIENT_URL --operation --dynWorkflow --taskIds urn:drat:RatAggregator
    popd >> $DRAT_HOME/logs/drat.log 2>&1
    print_ui_info
}

# Ensure the number of arguments matches the expected number. Expects three arguments:
# the option name, the actual number of arguments, and the expected number of arguments.
function check_num_args {
    if [[ "$2" != "$3" ]]; then
        echo "Expected $3 args for '$1', but got $2."
        print_help
        exit 1
    fi
}

# Return a list of what is running on a the given port. Expects 1 argument: the port number.
function check_port {
    check_num_args "check port" $# 1

#   Commented 'lsof' - Using 'nc' which helps to check port on Remote server as well 
#   lsof -i tcp:$1

    nc -z ${OODT_HOST} $1 &> /dev/null

    if [ $? == 0 ]; then
	echo 0
    else
	echo ""
    fi
}

# Check the Solr and OODT ports. If no arguments are passed, ensure the ports are all busy.
# Otherwise, check the ports are not busy.
function check_services_running {
    if [[ $# == 0 ]]; then
        if [[ ! -n $(check_port 9000) ]] || [[ ! -n $(check_port 9001) ]] || [[ ! -n $(check_port 9002) ]] || [[ ! -n $(check_port ${TOMCAT_PORT}) ]]; then
            echo "Please start OODT by running '\$DRAT_HOME/bin/oodt start'"
            echo "Aborting..."
            exit 1
        fi
    elif [[ -n $(check_port 9000) ]] || [[ -n $(check_port 9001) ]] || [[ -n $(check_port 9002) ]] || [[ -n $(check_port ${TOMCAT_PORT}) ]]; then
        echo "Please stop OODT by running '\$DRAT_HOME/bin/oodt stop'"
        echo "Aborting..."
        exit 1
    fi
    
}

function solr_delete_all {
    local core=$1
    curl -sf -H 'Content-Type: text/xml' "http://${OODT_HOST}:${SOLR_PORT}/solr/${core}/update?commit=true" \
        --data-binary '<delete><query>*:*</query></delete>' > /dev/null
}

# Reset the live services before a full command-line run. This clears the
# current crawl execution state while preserving historical DRAT stats.
function reset_running {
    check_services_running
    echo "Resetting live DRAT state"
    # /proteus is the Vue application now; the services moved to
    # /proteus-services when the modules were renamed. This called the old
    # path, and -sf meant the 404 was swallowed, so reset silently did
    # nothing and drat go carried on against stale state.
    curl -sf -X POST "http://${OODT_HOST}:${TOMCAT_PORT}/proteus-services/drat/reset" > /dev/null
    solr_delete_all drat
    rm -rf "$DRAT_HOME/data/archive/"*
    rm -rf "$DRAT_HOME/data/jobs/"*
    reset_workflow_instances
    reset_file_manager_catalog
}

# Empty the file manager catalog.
#
# Reset already clears the Solr core, which is an index of this catalog, so
# leaving the catalog itself populated left the two disagreeing: Solr said
# the repository was empty and the file manager still held every product
# from the last run. The audit's own output accumulated there too -- RatLog
# and RatAggregateLog grow with every run and nothing ever removed them.
#
# This means a reset implies a re-crawl, which is what "drat go" does
# anyway: crawl, index, map, reduce. A bare "drat reset" followed by "drat
# index" now indexes nothing, because there is nothing catalogued to index.
function reset_file_manager_catalog {
    local props="$DRAT_HOME/filemgr/etc/filemgr.properties"
    if [ ! -f "$props" ]; then
        echo "No filemgr.properties at $props; leaving the catalog alone"
        return 0
    fi

    local factory
    factory=$(grep -E '^[[:space:]]*filemgr.catalog.factory' "$props" \
        | tail -1 | cut -d= -f2- | tr -d '[:space:]')

    case "$factory" in
        *LuceneCatalogFactory*)
            local idx
            idx=$(read_prop "$props" "org.apache.oodt.cas.filemgr.catalog.lucene.idxPath")
            if [ -n "$idx" ] && [ -d "$idx" ]; then
                # A running file manager holds this index open. Deleting it
                # underneath one leaves a process that still listens on 9000
                # and fails every call, so the crawl that follows reports
                # "Exception connecting to filemgr" once per file and
                # ingests nothing. Take it down for the delete.
                local bounced=false
                if [[ -n $(check_port 9000) ]]; then
                    echo "Stopping the file manager to release $idx"
                    if ! stop_service "file manager" \
                            "$DRAT_HOME/filemgr/bin/filemgr" 9000; then
                        return 0
                    fi
                    bounced=true
                fi
                # The directory, not its contents. A Lucene catalog is
                # created when the directory is absent, so an emptied one
                # left the file manager with nothing it could open.
                echo "Clearing the file manager catalog at $idx"
                rm -rf "${idx:?}"
                if [[ "$bounced" == "true" ]]; then
                    echo "Restarting the file manager"
                    start_service "file manager" \
                        "$DRAT_HOME/filemgr/bin/filemgr" 9000
                fi
            fi
            ;;
        *SolrCatalogFactory*)
            # The catalog is a Solr core; emptying the core empties it.
            local core
            core=$(read_prop "$props" "org.apache.oodt.cas.filemgr.catalog.solr.url")
            core=${core##*/}
            if [ -n "$core" ]; then
                echo "Clearing the file manager catalog core $core"
                solr_delete_all "$core"
            fi
            ;;
        *)
            echo "File manager catalog [$factory] is not one this can clear;"
            echo "its products are being left alone."
            ;;
    esac
}

# Empty the workflow instance repository.
#
# Reset cleared the Solr core, the archive and the job directories and left
# every workflow instance behind, so a "reset" deployment came back up still
# holding the previous run's instances -- and an operations view showed them
# alongside the new ones with no way to tell which run they belonged to.
#
# Which store to clear depends on how the deployment is configured, so read
# it rather than assume. The two OODT ships are a Lucene index, where the
# instances are the directory, and a JDBC database, where they are rows: for
# the second, deleting the files would take the schema with them and the
# workflow manager would start against a database with no tables.
# Put a service down, and wait for it to actually be down.
#
# The control scripts return as soon as they have signalled the process; the
# store it holds -- a database file lock, an open Lucene index -- is released
# when the JVM exits, which is later. Emptying a store in between is the
# failure these are here to avoid, so this waits for the port to go quiet.
#
# Called with the label used in messages, the control script, and the port.
function stop_service {
    local label=$1 script=$2 port=$3
    "$script" stop >> $DRAT_HOME/logs/drat.log 2>&1 || true
    local waited=0
    while [[ -n $(check_port "$port") ]] && [[ $waited -lt 30 ]]; do
        sleep 1
        waited=$((waited + 1))
    done
    if [[ -n $(check_port "$port") ]]; then
        echo "The $label is still listening on $port after ${waited}s."
        echo "What it holds is being left alone."
        return 1
    fi
}

function start_service {
    local label=$1 script=$2 port=$3
    "$script" start >> $DRAT_HOME/logs/drat.log 2>&1 || true
    local waited=0
    while [[ ! -n $(check_port "$port") ]] && [[ $waited -lt 30 ]]; do
        sleep 1
        waited=$((waited + 1))
    done
    if [[ ! -n $(check_port "$port") ]]; then
        echo "The $label did not come back on $port after ${waited}s."
        echo "Start it with '$script start' before running."
        exit 1
    fi
}

function reset_workflow_instances {
    local props="$DRAT_HOME/workflow/etc/workflow.properties"
    if [ ! -f "$props" ]; then
        echo "No workflow.properties at $props; leaving instances alone"
        return 0
    fi

    local factory
    factory=$(grep -E '^[[:space:]]*workflow.engine.instanceRep.factory' "$props" \
        | tail -1 | cut -d= -f2- | tr -d '[:space:]')

    case "$factory" in
        *DataSourceWorkflowInstanceRepositoryFactory*)
            local url user pass
            url=$(read_prop "$props" "org.apache.oodt.cas.workflow.instanceRep.datasource.jdbc.url")
            user=$(read_prop "$props" "org.apache.oodt.cas.workflow.instanceRep.datasource.jdbc.user")
            pass=$(read_prop "$props" "org.apache.oodt.cas.workflow.instanceRep.datasource.jdbc.pass")
            if [ -z "$url" ]; then
                echo "No JDBC url configured; leaving workflow instances alone"
                return 0
            fi
            # An HSQLDB file database belongs to one process at a time, and
            # the workflow manager holds it open for as long as it runs. A
            # clear attempted underneath it fails with "Database lock
            # acquisition failure" and reset carries on, so the run that was
            # meant to start clean starts on top of every instance from the
            # last one. Nothing is in flight at reset, so the manager can be
            # put down for the few seconds this takes.
            local bounced=false
            if [[ "$url" == *hsqldb:file:* ]] && [[ -n $(check_port 9001) ]]; then
                echo "Stopping the workflow manager to release $url"
                if ! stop_service "workflow manager" \
                        "$DRAT_HOME/workflow/bin/wmgr" 9001; then
                    return 0
                fi
                bounced=true
            fi
            echo "Clearing workflow instances from $url"
            "$RUNJAVA" -cp "$DRAT_HOME/workflow/lib/*" \
                org.apache.oodt.cas.workflow.tools.ClearWorkflowInstances \
                "$url" "${user:-sa}" "$pass"
            if [[ "$bounced" == "true" ]]; then
                echo "Restarting the workflow manager"
                start_service "workflow manager" \
                    "$DRAT_HOME/workflow/bin/wmgr" 9001
            fi
            ;;
        *LuceneWorkflowInstanceRepositoryFactory*)
            local idx
            idx=$(read_prop "$props" "org.apache.oodt.cas.workflow.instanceRep.lucene.idxPath")
            if [ -n "$idx" ] && [ -d "$idx" ]; then
                echo "Clearing workflow instances from $idx"
                rm -rf "${idx:?}/"*
            fi
            ;;
        *)
            echo "Workflow instance repository [$factory] is not one this can"
            echo "clear; its instances are being left alone."
            ;;
    esac
}

# A property value with [DRAT_HOME] and friends resolved.
function read_prop {
    local file=$1 key=$2 value
    value=$(grep -E "^[[:space:]]*${key}[[:space:]]*=" "$file" | tail -1 | cut -d= -f2-)
    value=$(echo "$value" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
    echo "${value//\[DRAT_HOME\]/$DRAT_HOME}"
}

function full_wipe_running {
    check_services_running
    echo "Clearing historical DRAT stats"
    solr_delete_all statistics
}

# Attempt to automate crawling, indexing, mapping, and reducing. Expects 1 argument: the directory to analyze.
function go {
    check_services_running
    FULL_WIPE=false
    local -a EXCLUDE_ARGS=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --full-wipe)
                FULL_WIPE=true
                shift
            ;;
            --exclude)
                if [[ $# -lt 2 ]]; then
                    echo "Expected an exclude value after '--exclude'."
                    print_help
                    exit 1
                fi
                EXCLUDE_ARGS+=(--exclude "$2")
                shift 2
            ;;
            -*)
                echo "Unrecognized go option: '$1'"
                print_help
                exit 1
            ;;
            *)
                if [[ -n "${PRODUCT_PATH:-}" ]]; then
                    echo "Expected one repo path for 'go'."
                    print_help
                    exit 1
                fi
                PRODUCT_PATH=$1
                shift
            ;;
        esac
    done
    if [[ -z "${PRODUCT_PATH:-}" ]]; then
        echo "Expected a repo path for 'go'."
        print_help
        exit 1
    fi
    if [[ "$FULL_WIPE" == "true" ]]; then
        full_wipe_running
    fi
    reset_running
    echo "Crawling $PRODUCT_PATH"
    if [[ ${#EXCLUDE_ARGS[@]} -gt 0 ]]; then
        crawl "${EXCLUDE_ARGS[@]}" "$PRODUCT_PATH"
    else
        crawl "$PRODUCT_PATH"
    fi
    sleep 3
    echo
    echo "Indexing $PRODUCT_PATH"
    index $PRODUCT_PATH
    sleep 3
    echo
    # One instance for the whole audit, rather than a mapper and a reducer
    # submitted separately with the ordering between them kept here. What
    # follows a run afterwards has one thing to follow, and the engine holds
    # the ordering it was always the right place for.
    echo "Starting the audit"
    local before
    before=$(instance_ids)
    audit
    echo
    wait_for_audit "$before"
}

# Reset drat to prepare for analyzing an entirely new repo. Expects no arguments.
function reset {
    check_services_running "running"
    check_num_args "reset" $# 0
    echo "This will remove runtime crawl state while preserving historical DRAT stats."
    read -p "Do you wish to continue? [yN] " yn
        case $yn in
            [Yy]*)
                echo "rm -rf $DRAT_HOME/data/workflow"
                rm -rf $DRAT_HOME/data/workflow
                echo "rm -rf $DRAT_HOME/filemgr/catalog"
                rm -rf $DRAT_HOME/filemgr/catalog
                echo "rm -rf $DRAT_HOME/solr/drat/data"
                rm -rf $DRAT_HOME/solr/drat/data
                echo "rm -rf $DRAT_HOME/data/archive/*"
                rm -rf $DRAT_HOME/data/archive/*
                echo "rm -rf $DRAT_HOME/data/jobs/*"
                rm -rf $DRAT_HOME/data/jobs/*
                # The same two stores the live reset clears. Removing
                # data/workflow empties a Lucene instance repository and
                # filemgr/catalog a Lucene catalog, but a deployment holding
                # either in a database keeps everything through an offline
                # reset -- which is the one that looks the most thorough.
                reset_workflow_instances
                reset_file_manager_catalog
                echo "Please restart OODT with '\$DRAT_HOME/bin/oodt start' if you wish to run another crawl."
            ;;
            [Nn]*)
                echo "Reset cancelled. Exiting..."
                exit 0
            ;;
            *) 
                echo "Aborting..."
                exit 1
            ;;
        esac
}

# Clears the Solr Statistics repo for aggregating crawl stats. Expects no arguments.
function delstats {
    check_services_running "running"
    check_num_args "delstats" $# 0
    echo "This will remove any previous or current Solr DRAT stats information."
    read -p "Do you wish to continue? [yN] " yn
        case $yn in
            [Yy]*)
                echo "rm -rf $DRAT_HOME/solr/statistics/data"
                rm -rf $DRAT_HOME/solr/statistics/data
                echo "Please restart OODT with '\$DRAT_HOME/bin/oodt start' if you wish to run another crawl."
            ;;
            [Nn]*)
                echo "Reset cancelled. Exiting..."
                exit 0
            ;;
            *)
                echo "Aborting..."
                exit 1
            ;;
        esac

}

# Start parsing the arguments.
case $1 in
    crawl)
        shift
        crawl "$@"
    ;;
    index)
        shift
        index "$@"
    ;;
    map)
        shift
        map
    ;;
    reduce)
        shift
        reduce
    ;;
    audit)
        shift
        audit
    ;;
    go)
        shift
        go "$@"
    ;;
    reset)
        shift
        reset
    ;;
    delstats)
        shift
	delstats
    ;;
    help)
        print_help
    ;;
    *)
        echo "Unrecognized option: '$1'"
        print_help
        exit 1
    ;;
esac
